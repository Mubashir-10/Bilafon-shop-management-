{
  "name": "bilafon-mobile-shop-pro",
  "version": "1.0.1",
  "description": "Bilafon Mobile Shop Pro Desktop App",
  "main": "main.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "start": "electron .",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.bilafon.mobileshop",
    "productName": "Bilafon Mobile Shop Pro",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "frontend/public/favicon.ico"
    }
  }
}